# Base de données MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=asm_project

# Paramètres du scanner
TIMEOUT=1
MAX_PORTS=65535
THREADS=100
PORT_SCANNER_MODE=async
PORT_SCAN_CONCURRENCY=400

# IA Security Analyst
# Providers supportés : openai, anthropic, openrouter, ollama
# Pour OpenRouter : AI_BASE_URL=https://openrouter.ai/api/v1
# Pour Ollama local : AI_BASE_URL=http://localhost:11434/v1 AI_PROVIDER=openai AI_MODEL=llama3
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Paramètres de découverte
MAX_SUBDOMAINS=100





